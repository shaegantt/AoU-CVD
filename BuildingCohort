  0, 	1.35,   0,  	0.65,  TRUE,
  0, 	1,      2.6,	1, 	TRUE,
  0,	-0.65,   0, 	-1.35,  TRUE,
  0,	-2.65,   0, 	-3.35,  TRUE,
  0,	-4.65,   0, 	-5.35,  TRUE,
  0,	-1,      2.6,   -1, 	TRUE,
  0,	-3,      2.6,   -3, 	TRUE,
  0,	-5,      2.6,   -5, 	TRUE,
  0,	-6.65,   0, 	-7, 	FALSE,
  -3.5, -7,  	3.5,   -7, 	FALSE,
  -3.5, -7, 	-3.5,   -7.35,  TRUE,
  3.5,  -7,      3.5,   -7.35,  TRUE,
  -3.5, -8.65,  -3.5,   -9.85,  TRUE,
  -3.5, -11.15, -3.5,  -12.35,  TRUE,
  -3.5, -9.25,  -6.3,   -9.25,  TRUE,
  -3.5, -11.75, -6.3,  -11.75,  TRUE,
  3.5,  -8.65,   3.5,  -12.35,  TRUE,
  3.5,  -10.5,   6.3,  -10.5,   TRUE,
  -1.3, -13, 	1.3,  -13, 	FALSE
)
 
ggplot() +
  geom_segment(data = filter(arrows, head), aes(x, y, xend = xend, yend = yend),
               arrow = arrow(length = unit(2, "mm"), type = "closed")) +
  geom_segment(data = filter(arrows, !head), aes(x, y, xend = xend, yend = yend),
               linetype = "dashed") +
  geom_rect(data = boxes, aes(xmin = x - w / 2, xmax = x + w / 2,
                          	ymin = y - h / 2, ymax = y + h / 2, fill = type),
            colour = "black", linewidth = 0.4) +
  geom_text(data = boxes, aes(x, y, label = label), size = 2.9, lineheight = 0.95) +
  annotate("text", x = 0, y = -12.6, label = "same\nindex date", size = 2.6) +
  scale_fill_manual(values = c(main = "white", excl = "grey93"), guide = "none") +
  coord_fixed(clip = "off") +
  theme_void()
 
 
# Figure 2. Timeline of data collection (Plots)
tl <- tribble(
  ~row,  	~start,   	~end,     	~what,
  "Case",    -REF_WIN[2],  -REF_WIN[1],  "Reference window",
  "Case",    -EXP_WIN[2],  -EXP_WIN[1],  "Exposure window",
  "Case",	-6,       	-1,       	"Not used",
  "Control", -REF_WIN[2],  -REF_WIN[1],  "Reference window",
  "Control", -EXP_WIN[2],  -EXP_WIN[1],  "Exposure window",
  "Control", -6,           -1,       	"Not used",
  "Control", 0,            FREE_AFTER,   "Event-free follow-up"
) |>
  mutate(y = ifelse(row == "Case", 2, 1),
     	label = ifelse(what == "Not used", "",
                        paste0(what, "\n(day ", start, " to ", ifelse(end > 0, "+", ""), end, ")")))
 
ggplot(tl) +
  geom_rect(aes(xmin = start, xmax = end + 1, ymin = y - 0.28, ymax = y + 0.28, fill = what),
            colour = "white") +
  geom_text(aes(x = (start + end + 1) / 2, y = y, label = label), size = 3, lineheight = 0.9) +
  geom_vline(xintercept = 0, linetype = "dashed", colour = "grey40") +
  annotate("point", x = 0, y = 2, shape = 23, size = 4, fill = "#CB181D") +
  annotate("point", x = 0, y = 1, shape = 23, size = 4, fill = "white") +
  annotate("text", x = 2, y = 2.45, hjust = 0, size = 3,
       	label = "Day 0: first acute CVD hospitalization (index date)") +
  annotate("text", x = 2, y = 1.45, hjust = 0, size = 3,
       	label = "Day 0: case's index date (risk-set sampling)") +
  annotate("segment", x = -118, xend = -1, y = 2.95, yend = 2.95,
       	arrow = arrow(length = unit(2, "mm"), type = "closed")) +
  annotate("text", x = -118, y = 3.2, hjust = 0, size = 3,
       	label = "EHR visit in prior year; covariates before index | prior CVD assessed before Fitbit start") +
  scale_fill_manual(values = c("Reference window" = "#9ECAE1", "Exposure window" = "#FDAE6B",
                           	"Not used" = "grey85", "Event-free follow-up" = "#A1D99B"),
                    guide = "none") +
  scale_x_continuous(breaks = c(-REF_WIN[2], -REF_WIN[1], -EXP_WIN[1], 0, FREE_AFTER),
                     labels = c(-REF_WIN[2], -REF_WIN[1], -EXP_WIN[1], 0, paste0("+", FREE_AFTER)),
                     limits = c(-120, 100)) +
  scale_y_continuous(breaks = 1:2, labels = c("Control", "Case"), limits = c(0.6, 3.35)) +
  labs(x = "Days relative to index date", y = NULL,
   	caption = paste0("Valid Fitbit day: ≥ ", MIN_STEPS, " steps and 10-24 h of heart-rate data; ",
                        "≥ ", MIN_EXP_DAYS, " valid days in exposure and ≥ ",
                        MIN_REF_DAYS, " in reference window")) +
  theme_minimal(base_size = 11) +
  theme(panel.grid = element_blank(),
        axis.text.y = element_text(face = "bold", size = 11),
        axis.line.x = element_line())

