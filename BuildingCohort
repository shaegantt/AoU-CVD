# Each person's records from (index - far) to (index - near) days
window_join <- function(events, date_col, val_col, members, near, far) {
  event_dates <- events |>
    transmute(person_id, event_date = as.Date(.data[[date_col]]), val = .data[[val_col]])
  windows <- members |>
    transmute(member_id, person_id, index_date = as.Date(index_date),
              win_start = index_date - far, win_end = index_date - near)
  event_dates |>
    inner_join(windows, by = join_by(person_id, between(event_date, win_start, win_end)),
               relationship = "many-to-many") |>
    transmute(member_id, days_before = as.integer(index_date - event_date), val)
}
 
