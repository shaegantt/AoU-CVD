# Keep only SNOMED concepts specific to our definition:
# drop concepts that ICD codes outside the definition also map to
map_to_snomed <- function(icd_ids) {
  ours  <- icd_maps |> filter(icd_id %in% icd_ids)
  other <- icd_maps |> filter(!icd_id %in% icd_ids)
  setdiff(unique(ours$snomed_id), unique(other$snomed_id)) |> as.integer()
}
