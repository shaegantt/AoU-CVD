# Records matching a definition: ICD-sourced -> our ICD list;
# SNOMED / no source code -> exact mapped SNOMED concept
cvd_records <- function(icd_ids, snomed_ids, use_snomed = USE_SNOMED) {
  rec <- tbl(con, "condition_occurrence") |>
    left_join(tbl(con, "concept") |>
                select(condition_source_concept_id = concept_id, src_vocab = vocabulary_id),
          	by = "condition_source_concept_id") |>
	mutate(is_icd = coalesce(src_vocab, "none") %in% c("ICD10CM", "ICD9CM"))
  if (!use_snomed) {
	return(rec |> filter(condition_source_concept_id %in% !!as.integer(icd_ids)))
  }
  rec |>
    filter(condition_source_concept_id %in% !!as.integer(icd_ids) |
             (!is_icd & condition_concept_id %in% !!as.integer(snomed_ids)))
}
 
