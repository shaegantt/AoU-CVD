# Format/Compact ICD text
icd_cat <- function(code) sub("\\..*$", "", code)
 
format_codes <- function(ids, vocab) {
  voc <- icd_all |> filter(vocabulary_id == vocab) |>
	mutate(cat = icd_cat(concept_code))
  sel <- voc |> filter(concept_id %in% ids)
  if (nrow(sel) == 0) return("-")
  leaves <- voc |> filter(concept_code != cat)
  full <- leaves |> filter(cat %in% sel$cat) |>
	group_by(cat) |>
    summarise(full = all(concept_code %in% sel$concept_code), .groups = "drop")
  sel <- sel |> left_join(full, by = "cat") |> mutate(full = coalesce(full, TRUE))
 
  all_cats  <- sort(unique(voc$cat))
  full_cats <- sort(unique(selcat[selfull]))
  ranges <- character(0)
  if (length(full_cats) > 0) {
	grp <- cumsum(c(TRUE, diff(match(full_cats, all_cats)) != 1))
	ranges <- tapply(seq_along(full_cats), grp, \(i)
                     if (length(i) == 1) paste0(full_cats[i], ".x")
                     else paste0(full_cats[min(i)], "-", full_cats[max(i)]))
  }
  part <- sel |> filter(!full, concept_code != cat) |>
	mutate(sub = substr(concept_code, 1, nchar(cat) + 2))
  sub_full <- leaves |>
	mutate(sub = substr(concept_code, 1, nchar(cat) + 2)) |>
	filter(sub %in% part$sub) |>
	group_by(sub) |>
    summarise(n_all = n(), all_in = all(concept_code %in% part$concept_code),
              .groups = "drop")
  part <- part |> left_join(sub_full, by = "sub")
  part_txt <- sort(c(
    sprintf("%sx", part |> filter(all_in, n_all > 1) |> distinct(sub) |> pull(sub)),
	part |> filter(!(all_in & n_all > 1)) |> pull(concept_code)))
  paste(c(unname(ranges), part_txt), collapse = ", ")
}
 
